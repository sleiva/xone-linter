{
  "name": "xone-linter",
  "version": "1.2.0",
  "description": "Simulador y validador ligero de apps XOne para agentes autónomos",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "xone-simulator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "validate": "node ./dist/cli.js validate",
    "repl": "node ./dist/repl.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "xone",
    "simulator",
    "validator",
    "linter",
    "low-code",
    "mobile"
  ],
  "author": "Sergio Leiva",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "iconv-lite": "^0.6.3",
    "picocolors": "^1.1.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
